#
# https://editorconfig.org — tabs everywhere, except where a format requires spaces.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[{package.json,package-lock.json,composer.json,*.webmanifest}]
indent_style = space
indent_size = 2

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[{LICENSE,*.po,*.pot}]
indent_style = unset
max_line_length = unset

[{js,l10n,vendor,node_modules,build}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = unset

[tests/fixtures/**.json]
insert_final_newline = unset
indent_style = unset
max_line_length = unset
