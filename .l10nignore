#
# Paths the Nextcloud translation tool skips when it extracts strings (one prefix per line, relative to the
# app root). Strings are extracted from the sources in src/, lib/, templates/ and appinfo/info.xml.
# Built bundles (generated from src/)
js/
assets/
build/
# Development only (and generated test output)
src/components/board/dev/
vendor/
tests/
tools/
docs/
screenshots/
translationfiles/
coverage/
playwright-report/
test-results/
