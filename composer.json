{
	"name": "bee-flow/quantumchess",
	"description": "Quantum Chess for Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "BeeFlow",
			"homepage": "https://beeflow.nl"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\QuantumChess\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\QuantumChess\\Tests\\": "tests/php/"
		}
	},
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable32",
		"phpunit/phpunit": "^10.5",
		"vimeo/psalm": "^6.0",
		"nextcloud/coding-standard": "^1.3"
	},
	"scripts": {
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './node_modules/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --no-cache --threads=1",
		"test:unit": "phpunit -c tests/php/phpunit.xml"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.1.31"
		}
	}
}
