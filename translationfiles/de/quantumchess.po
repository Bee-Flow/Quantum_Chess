msgid "General"
msgstr "General"

#: src/variants/xiangqi.js:370
msgid "Advisor"
msgstr "Berater"

#: src/variants/xiangqi.js:376
msgid "Elephant"
msgstr "Elefant"

#: src/variants/xiangqi.js:383
msgid "Horse"
msgstr "Pferd"

