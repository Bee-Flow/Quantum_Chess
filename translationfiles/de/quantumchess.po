msgstr[1] "Zeitreise: {turns} Züge zurück"

#: src/variants/multiverse/texts.js:576
msgid "Submit turn (your royal queen can be taken: {percent})"
msgstr "Zug beenden (deine königliche Dame kann geschlagen werden: {percent})"

#: src/variants/multiverse/texts.js:578
msgid "Submit turn (a king or royal queen of yours can be taken: {percent})"
msgstr "Zug beenden (eine deiner königlichen Figuren kann geschlagen werden: {percent})"

#: src/variants/multiverse/texts.js:582
msgid "Submit turn (a king of yours can be taken: {percent})"
msgstr "Zug beenden (einer deiner Könige kann geschlagen werden: {percent})"

#. TRANSLATORS: the Submit button of the multiverse while must-move boards are left; keep it short (phones)
#: src/variants/multiverse/texts.js:589
