#: src/variants/multiverse/texts.js:452
msgid "The past still remembers both paths until {board} is sealed"
msgstr "Het verleden onthoudt nog beide wegen tot {board} verzegeld is"

#. TRANSLATORS: in a player's row of the multiverse: the new timelines this player opened, of the most allowed
#: src/variants/multiverse/texts.js:469
msgid "New timelines {count}/{max}"
msgstr "Nieuwe tijdlijnen {count}/{max}"

#: src/variants/multiverse/texts.js:475
msgid "{timelines} · Must move: {count} board"
msgid_plural "{timelines} · Must move: {count} boards"
msgstr[0] "{timelines} · Verplicht: {count} bord"
msgstr[1] "{timelines} · Verplicht: {count} borden"

#: src/variants/multiverse/texts.js:483
msgid "{timelines} · Must move: {boards}"
msgstr "{timelines} · Verplicht: {boards}"

#: src/variants/multiverse/texts.js:490
msgid "New timelines opened by this side, of {max}. Its next one counts for the present (is active) while the other side has opened at least as many."
msgstr "Nieuwe tijdlijnen die deze kant heeft geopend, van de {max} toegestane. De volgende telt mee voor het heden (is actief) zolang de andere kant er minstens evenveel heeft geopend."

#. TRANSLATORS: above the multiverse: how many new timelines each player has opened, of the most allowed
#: src/variants/multiverse/texts.js:507
msgid "New timelines: White {white}/{max} · Black {black}/{max}"
msgstr "Nieuwe tijdlijnen: Wit {white}/{max} · Zwart {black}/{max}"

#. TRANSLATORS: above the multiverse, after the new timelines: how many turns back pieces can travel
#: src/variants/multiverse/texts.js:514
msgid "Travel back: {turns} turn"
msgid_plural "Travel back: {turns} turns"
msgstr[0] "Terugreizen: {turns} beurt"
msgstr[1] "Terugreizen: {turns} beurten"

#: src/variants/multiverse/texts.js:576
msgid "Submit turn (your royal queen can be taken: {percent})"
msgstr "Beurt beëindigen (je koninklijke dame kan geslagen worden: {percent})"

#: src/variants/multiverse/texts.js:578
msgid "Submit turn (a king or royal queen of yours can be taken: {percent})"
msgstr "Beurt beëindigen (een koning of koninklijke dame van je kan geslagen worden: {percent})"

#: src/variants/multiverse/texts.js:582
msgid "Submit turn (a king of yours can be taken: {percent})"
msgstr "Beurt beëindigen (een koning van je kan geslagen worden: {percent})"

#. TRANSLATORS: the Submit button of the multiverse while must-move boards are left; keep it short (phones)
#: src/variants/multiverse/texts.js:589
msgid "Submit turn ({count} more board first)"
msgid_plural "Submit turn ({count} more boards first)"
msgstr[0] "Beurt beëindigen (eerst nog {count} bord)"
msgstr[1] "Beurt beëindigen (eerst nog {count} borden)"

#: src/variants/multiverse/texts.js:647
msgid "Your king or royal queen is in danger on {boards}: {percent}"
msgstr "Je koning of koninklijke dame is in gevaar op {boards}: {percent}"

#: src/variants/multiverse/texts.js:650
msgid "Your royal queen is in danger on {boards}: {percent}"
msgstr "Je koninklijke dame is in gevaar op {boards}: {percent}"

#. TRANSLATORS: the danger line of the multiverse (5D check), "Your king is in danger on (0T2) ○: 100 %"
#: src/variants/multiverse/texts.js:653
msgid "Your king is in danger on {boards}: {percent}"
msgstr "Je koning is in gevaar op {boards}: {percent}"

#. TRANSLATORS: under the result of a multiverse game won by capturing a king or royal queen
#: src/variants/multiverse/texts.js:675
msgid "The royal piece on {square} was captured."
msgstr "Het koninklijke stuk op {square} is geslagen."

#. TRANSLATORS: under the result of a multiverse game lost by checkmate: where the royal piece could be taken
#: src/variants/multiverse/texts.js:682
msgid "A royal piece could be taken for certain on {boards}."
msgstr "Op {boards} kon een koninklijk stuk zeker geslagen worden."

#. TRANSLATORS: the hint of the multiverse once every must-move board of the turn is played
#: src/variants/multiverse/texts.js:699
msgid "Required boards done: move on an optional board (blue), or press Submit turn."
msgstr "Verplichte borden gespeeld: zet op een optioneel bord (blauw) of druk op “Beurt beëindigen”."

#: src/variants/multiverse/texts.js:714
msgid "Measure through a part on a board you may play now (gold or blue)."
msgstr "Meet via een deel op een bord waarop je nu mag spelen (goud of blauw)."

#: src/variants/multiverse/texts.js:716
msgid "Both parts must stand on one board you may play now (gold or blue)."
msgstr "Beide delen moeten op één bord staan waarop je nu mag spelen (goud of blauw)."

#: src/variants/multiverse/texts.js:721
msgid "This piece has no move now."
msgstr "Dit stuk kan nu niet zetten."

#: src/variants/multiverse/texts.js:723
msgid "You can move only on the boards marked must move or optional (gold or blue)."
msgstr "Je kunt alleen zetten op de borden met “verplicht” of “optioneel” (goud of blauw)."

#. TRANSLATORS: why a multiverse game ended: a royal piece (a king or a royal queen) was captured
#: src/variants/multiverse/texts.js:740
msgid "a king or royal queen was captured"
msgstr "een koning of koninklijke dame is geslagen"

#. TRANSLATORS: why a multiverse game ended: the loser could not finish its turn, a royal piece would fall
#: src/variants/multiverse/texts.js:743
msgid "checkmate: the turn could not be finished and a king or royal queen would certainly be captured"
msgstr "schaakmat: de beurt kon niet worden afgemaakt en een koning of koninklijke dame zou zeker geslagen worden"

#. TRANSLATORS: why a multiverse game was drawn: the player to move could not finish its turn
#: src/variants/multiverse/texts.js:749
msgid "stalemate: the turn could not be finished"
msgstr "pat: de beurt kon niet worden afgemaakt"

#. TRANSLATORS: why a multiverse game ended: the loser's own move left its turn impossible to finish
#: src/variants/multiverse/texts.js:752
msgid "stranded: the loser's own move left its turn impossible to finish"
msgstr "vastgelopen: door een eigen zet kon de verliezer de beurt niet meer afmaken"

#. TRANSLATORS: why a multiverse game was drawn; a brawn is a kind of pawn
#: src/variants/multiverse/texts.js:755
msgid "300 moves in a row (Submit turn counts) without a capture or a pawn or brawn move"
msgstr "300 zetten achter elkaar (“Beurt beëindigen” telt mee) zonder slag of zet van een pion of krachtpion"

#. TRANSLATORS: why a multiverse game was drawn: the game reached its move limit
#: src/variants/multiverse/texts.js:761
msgid "1,200 moves in the game (Submit turn counts)"
msgstr "1.200 zetten in de partij (“Beurt beëindigen” telt mee)"

#: src/variants/raumschach.js:200
msgid "The board is a cube of five levels, from A at the bottom (White's home) to E at the top (Black's home); a cell is named level, file, rank, so Cc3 is the centre."
msgstr "Het bord is een kubus van vijf niveaus, van A onderaan (het thuisniveau van Wit) tot E bovenaan (dat van Zwart); de naam van een veld is niveau, lijn en rij, dus Cc3 is het midden."

#: src/variants/raumschach.js:204
msgid "Rooks move straight, also up and down; bishops move diagonally within any flat slice of the cube; unicorns move through the corners, changing level, file and rank at once."
msgstr "Torens gaan recht, ook omhoog en omlaag; lopers gaan diagonaal binnen elke platte doorsnede van de kubus; eenhoorns gaan door de hoekpunten en veranderen tegelijk van niveau, lijn en rij."

#: src/variants/raumschach.js:208
msgid "The queen moves like a rook, bishop or unicorn, the king steps to any of the 26 touching cells, and the knight jumps 2 cells one way and 1 another, also across levels."
msgstr "De dame gaat als een toren, loper of eenhoorn, de koning stapt naar een van de 26 aangrenzende velden, en het paard springt 2 velden in de ene richting en 1 in een andere, ook over niveaus heen."

#: src/variants/raumschach.js:212
msgid "Pawns step one cell forward or one level up, and capture one cell forward and sideways, up and sideways, or forward and up, never straight ahead or straight up. For Black, forward is towards rank 1 and up is towards level A."
msgstr "Pionnen stappen één veld vooruit of één niveau omhoog, en slaan één veld vooruit en opzij, omhoog en opzij, of vooruit en omhoog, nooit recht vooruit of recht omhoog. Voor Zwart is vooruit richting rij 1 en omhoog richting niveau A."

#: src/variants/raumschach.js:216
msgid "A pawn that reaches the far rank of the opponent's home level (White: rank 5 of E; Black: rank 1 of A) must become a queen, rook, bishop, knight or unicorn."
msgstr "Een pion die de verste rij van het thuisniveau van de tegenstander bereikt (Wit: rij 5 van E; Zwart: rij 1 van A), moet een dame, toren, loper, paard of eenhoorn worden."

#: src/variants/raumschach.js:220
msgid "There is no castling, no double step and no en passant."
msgstr "Er is geen rokade, geen dubbele stap en geen en passant."

#: src/variants/raumschach.js:222
msgid "If only the two kings are left and they do not touch, the game is drawn."
msgstr "Als alleen de twee koningen over zijn en ze niet naast elkaar staan, is het remise."

#: src/variants/shogi.js:197
msgid "Sente"
msgstr "Sente"

#: src/variants/shogi.js:198
msgid "Gote"
msgstr "Gote"

#: src/variants/shogi.js:223
msgid "Gold general"
msgstr "Gouden generaal"

#: src/variants/shogi.js:225
msgid "Silver general"
msgstr "Zilveren generaal"

#: src/variants/shogi.js:239
msgid "Lance"
msgstr "Lans"

#: src/variants/shogi.js:254
msgid "Dragon (promoted rook)"
msgstr "Draak (gepromoveerde toren)"

#: src/variants/shogi.js:260
msgid "Horse (promoted bishop)"
msgstr "Drakenpaard (gepromoveerde loper)"

#: src/variants/shogi.js:265
msgid "Promoted silver"
msgstr "Gepromoveerd zilver"

#: src/variants/shogi.js:267
msgid "Promoted lance"
msgstr "Gepromoveerde lans"

#: src/variants/shogi.js:268
msgid "Tokin (promoted pawn)"
msgstr "Tokin (gepromoveerde pion)"

#: src/variants/shogi.js:278
msgid "Sente moves first. Every piece captures the way it moves; the pawn captures straight ahead."
msgstr "Sente begint. Elk stuk slaat zoals het zet; de pion slaat recht vooruit."

#: src/variants/shogi.js:282
msgid "Captured pieces join your hand unpromoted. Instead of moving you may drop one, unpromoted, onto any empty square; if a ghost might stand there, a roll decides."
msgstr "Geslagen stukken gaan ongepromoveerd naar je hand. In plaats van een zet mag je er een, ongepromoveerd, op een leeg veld naar keuze inzetten; als daar een spookstuk kan staan, beslist een worp."

#: src/variants/shogi.js:286
msgid "You may not drop a pawn on a file that holds one of your unpromoted pawns, nor a pawn, lance or knight where it could never move."
msgstr "Je mag geen pion inzetten op een lijn waarop al een ongepromoveerde pion van je staat, en ook geen pion, lans of paard op een veld waar hij nooit meer kan zetten."

#: src/variants/shogi.js:290
msgid "You may not drop a pawn that attacks the enemy king and leaves it no escape; if that is so in only some possibilities, the drop misses in those."
msgstr "Je mag geen pion inzetten die de vijandelijke koning aanvalt en hem elke ontsnapping ontneemt; als dat maar in sommige mogelijkheden zo is, mist de inzet in die mogelijkheden."

#: src/variants/shogi.js:294
msgid "Every piece but the king and the golds may promote (red) when it moves into, within or out of the three far ranks; a pawn or lance on the last rank and a knight on the last two must."
msgstr "Elk stuk behalve de koning en de gouden generaals mag promoveren (rood) als het een zet naar, binnen of vanuit de drie verste rijen doet; een pion of lans op de laatste rij en een paard op de laatste twee rijen moet promoveren."

#: src/variants/shogi.js:298
msgid "A tokin (promoted pawn) is not solid: it can split. A ghost promotes only in the possibilities where it really moves, and parts with different faces cannot merge."
msgstr "Een tokin (gepromoveerde pion) staat niet vast: hij kan splitsen. Een spookstuk promoveert alleen in de mogelijkheden waarin het echt zet, en delen die met een andere kant boven liggen, kunnen niet samenvoegen."

#: src/variants/shogi.js:302
msgid "You also win by impasse: start your turn with your king, unattacked, and at least ten other pieces in the enemy camp, and at least 28 points as Sente or 27 as Gote, counting your pieces in the enemy camp and in your hand (rooks and bishops, promoted or not, 5; other pieces 1; the king 0)."
msgstr "Je wint ook door impasse: begin je beurt met je koning, niet aangevallen, en minstens tien andere stukken in het vijandelijk kamp, en met minstens 28 punten als Sente of 27 als Gote, geteld over je stukken in het vijandelijk kamp en in je hand (torens en lopers, gepromoveerd of niet, 5; andere stukken 1; de koning 0)."

#: src/variants/shogi.js:306
msgid "A player who has no move at all loses. The game is drawn after 50 moves by each side without a capture, a drop or a pawn move actually happening, or after 500 moves in total."
msgstr "Een speler die helemaal geen zet heeft, verliest. Het is remise na 50 zetten per kant zonder dat er echt een slag, inzet of pionzet plaatsvindt, of na 500 zetten in totaal."

#: src/variants/shogi.js:461
msgid "impasse: the 27-point rule"
msgstr "impasse: de 27-puntenregel"

#: src/variants/shogi.js:463
msgid "50 moves without a capture, a drop or a pawn move"
msgstr "50 zetten zonder slag, inzet of pionzet"

#: src/variants/shogi.js:465
msgid "the other player cannot move"
msgstr "de andere speler kan niet zetten"

#: src/variants/threecheck.js:210
msgid "three checks"
msgstr "driemaal schaak"

#. TRANSLATORS: Three-check, the result of a roll that ended the game; {side} is White or Black
#: src/variants/threecheck.js:221
msgid "Third check: {side} wins"
msgstr "Derde schaak: {side} wint"

#. TRANSLATORS: Three-check, the result of a roll that decided a check: how many checks each side has given
#: src/variants/threecheck.js:223
msgid "Checks: White {white}, Black {black}"
msgstr "Schaak: Wit {white}, Zwart {black}"

#: src/variants/threecheck.js:229
msgid "Checks: {count}/3"
msgstr "Schaak: {count}/3"

#: src/variants/threecheck.js:230
msgid "Checks given: {count} of 3"
msgstr "Schaak gegeven: {count} van 3"

#. TRANSLATORS: Three-check, a line of the move list, "White gave check (2 of 3)"; {side} is White or Black
#: src/variants/threecheck.js:244
msgid "{side} gave check ({count} of 3)"
msgstr "{side} gaf schaak ({count} van 3)"

#: src/variants/threecheck.js:259
msgid "Give check three times to win. Capturing the king also wins."
msgstr "Geef drie keer schaak om te winnen. De koning slaan wint ook."

#: src/variants/threecheck.js:260
msgid "A check is a move after which one of your pieces (not your king) attacks the enemy king; a double check counts once."
msgstr "Een schaak is een zet waarna een van je stukken (niet je koning) de vijandelijke koning aanvalt; een dubbelschaak telt één keer."

#: src/variants/threecheck.js:264
msgid "Checks are always certain: if a move gives check in only some possibilities, a roll settles it at once, even after castling or en passant."
msgstr "Schaak is altijd zeker: als een zet maar in sommige mogelijkheden schaak geeft, beslist meteen een worp, ook na een rokade of en passant."

#: src/variants/threecheck.js:268
msgid "A move that misses gives no check, even if the enemy king is attacked. Measuring never gives check."
msgstr "Een zet die mist, geeft geen schaak, ook als de vijandelijke koning aangevallen wordt. Meten geeft nooit schaak."

#: src/variants/threecheck.js:272
msgid "A check left standing counts again after each of your moves, as long as the enemy king is still attacked."
msgstr "Een schaak dat blijft staan, telt na elke zet van jou opnieuw, zolang de vijandelijke koning nog aangevallen wordt."

#: src/variants/threecheck.js:277
msgid "The counters next to the player names show how many checks each side has given."
msgstr "De tellers naast de namen van de spelers tonen hoe vaak elke kant schaak heeft gegeven."

#: src/variants/trid.js:610
msgid "To move an attack board, tap its pin name, then the name of a free pin (dashed)."
msgstr "Om een aanvalsbord te verplaatsen, tik je op de naam van zijn pen en dan op de naam van een vrije pen (gestippeld)."

#: src/variants/trid.js:613
msgid "Three 4 × 4 main levels, White's (W, lowest), Neutral (N) and Black's (B, highest), and four 2 × 2 attack boards on pins at the corners of the main levels: QL1 to QL6 on the queen's side and KL1 to KL6 on the king's side, numbered from White's end. White's boards start on QL1 and KL1, Black's on QL6 and KL6."
msgstr "Drie hoofdniveaus van 4 × 4, dat van Wit (W, het laagste), het neutrale (N) en dat van Zwart (B, het hoogste), en vier aanvalsborden van 2 × 2 op pennen bij de hoeken van de hoofdniveaus: QL1 tot en met QL6 op de damevleugel en KL1 tot en met KL6 op de koningsvleugel, genummerd vanaf de kant van Wit. De borden van Wit beginnen op QL1 en KL1, die van Zwart op QL6 en KL6."

#: src/variants/trid.js:617
msgid "A square is named file, rank and board, such as b3N or z0QL1. Seen from above, all boards form one map with files z to e and ranks 0 to 9: b3W and b3N are the two levels of map square b3. The squares of a pin exist only while a board stands on it."
msgstr "De naam van een veld is lijn, rij en bord, zoals b3N of z0QL1. Van boven gezien vormen alle borden één kaart met de lijnen z tot en met e en de rijen 0 tot en met 9: b3W en b3N zijn de twee niveaus van kaartveld b3. De velden van een pen bestaan alleen zolang er een bord op staat."

#: src/variants/trid.js:621
msgid "Every move is an ordinary chess move on that map and may stop on any level of the target map square. Moving straight up or down is not a move. A piece on any level of a map square in between blocks the move; gaps without a board are empty: pieces fly across them but cannot stop there."
msgstr "Elke zet is een gewone schaakzet op die kaart en mag eindigen op elk niveau van het kaartveld waar hij naartoe gaat. Recht omhoog of omlaag gaan is geen zet. Een stuk op een niveau van een kaartveld ertussen blokkeert de zet; gaten zonder bord zijn leeg: stukken vliegen eroverheen maar kunnen er niet stoppen."

#: src/variants/trid.js:625
msgid "Instead of a piece you may move an attack board that holds at most one piece to a free pin next to it: one or two numbers up or down on the same side (QL3 reaches QL1, QL2, QL4 and QL5), or across to the same number (KL3). An empty board belongs to the side it started with, a board with a piece to that piece's side and carries it along; only an empty board may move backwards."
msgstr "In plaats van een stuk mag je een aanvalsbord met hoogstens één stuk erop naar een vrije pen ernaast verplaatsen: één of twee nummers hoger of lager op dezelfde vleugel (vanaf QL3 bereik je QL1, QL2, QL4 en QL5), of naar hetzelfde nummer op de andere vleugel (KL3). Een leeg bord hoort bij de kant waarbij het begon, een bord met een stuk hoort bij de kant van dat stuk en neemt het mee; alleen een leeg bord mag achteruit."

#: src/variants/trid.js:629
msgid "Pawns step forward (two map squares on their first move, but not after riding a board) and capture diagonally forward, onto any level. En passant lands on either level of the skipped square."
msgstr "Pionnen stappen vooruit (twee kaartvelden bij hun eerste zet, maar niet als ze al met een bord zijn meegereden) en slaan schuin vooruit, op elk niveau. En passant landt op een van beide niveaus van het overgeslagen veld."

#: src/variants/trid.js:633
msgid "A pawn promotes on the last rank of its file: rank 8 on files b and c, rank 9 on files z and e, and on files a and d rank 9 while a board stands on the pin over the far corner (QL6, KL6), else rank 8 (for Black rank 1 and rank 0, with QL1 and KL1). A pawn that a board move takes to its last rank, or leaves on it, promotes at once: your own to the piece you pick, the other side's to a queen."
msgstr "Een pion promoveert op de laatste rij van zijn lijn: rij 8 op de lijnen b en c, rij 9 op de lijnen z en e, en op de lijnen a en d rij 9 zolang er een bord op de pen boven de verste hoek staat (QL6, KL6), anders rij 8 (voor Zwart rij 1 en rij 0, met QL1 en KL1). Een pion die door een bordzet op zijn laatste rij terechtkomt of daar blijft staan, promoveert meteen: je eigen pion tot het stuk dat je kiest, een pion van de andere kant tot dame."

#: src/variants/trid.js:637
msgid "You may castle from your second move on, if neither the king nor that rook has moved in any possibility. On the king's side the king and the rook next to it swap places; on the queen's side, once the queen's square is empty, the king goes there and the corner rook goes to the king's square."
msgstr "Je mag rokeren vanaf je tweede zet, als de koning en die toren in geen enkele mogelijkheid gezet hebben. Op de koningsvleugel wisselen de koning en de toren ernaast van plaats; op de damevleugel gaat de koning, zodra het veld van de dame leeg is, daarheen en gaat de hoektoren naar het veld van de koning."

#: src/variants/trid.js:641
msgid "Quantum tip: a ghost on either level of a map square blocks moves across it in its possibilities, and a piece split over both levels of one map square blocks it for certain. A ghost on the other level of your target square does not matter. Attack boards are never ghosts: a ghost on a moving board rides along where it stands, and a board move that a ghost prevents in some possibilities is settled by a roll."
msgstr "Kwantumtip: een spookstuk op een van beide niveaus van een kaartveld blokkeert zetten eroverheen in zijn mogelijkheden, en een stuk dat over beide niveaus van één kaartveld gesplitst is, blokkeert het zeker. Een spookstuk op het andere niveau van je doelveld maakt niet uit. Aanvalsborden zijn nooit spookstukken: een spookstuk op een bord dat verplaatst wordt, gaat mee waar het staat, en over een bordzet die een spookstuk in sommige mogelijkheden verhindert, beslist een worp."

#. TRANSLATORS: Tri-D chess, read out by screen readers; {pin} is the name of a pin, such as QL1
#: src/variants/trid/layout.js:265
msgid "Attack board on {pin}"
msgstr "Aanvalsbord op {pin}"

#. TRANSLATORS: Tri-D chess, read out by screen readers; {pin} is the name of a pin, such as QL3
#: src/variants/trid/layout.js:267
msgid "Free pin {pin}"
msgstr "Vrije pen {pin}"

#: src/variants/xiangqi.js:363
msgid "General"
msgstr "Generaal"

#: src/variants/xiangqi.js:370
msgid "Advisor"
msgstr "Adviseur"

#: src/variants/xiangqi.js:376
msgid "Elephant"
msgstr "Olifant"

#: src/variants/xiangqi.js:383
msgid "Horse"
msgstr "Paard"

#: src/variants/xiangqi.js:393
msgid "Chariot"
msgstr "Wagen"

#: src/variants/xiangqi.js:399
msgid "Cannon"
msgstr "Kanon"

#: src/variants/xiangqi.js:405
msgid "Soldier"
msgstr "Soldaat"

#: src/variants/xiangqi.js:418
msgid "Pieces stand on the points where the lines cross. Red moves first. The river divides the board, and each side has a palace: the 3 × 3 points marked with two diagonal lines."
msgstr "De stukken staan op de punten waar de lijnen elkaar kruisen. Rood begint. De rivier verdeelt het bord, en elke kant heeft een paleis: de 3 × 3 punten die met twee diagonale lijnen gemarkeerd zijn."

#: src/variants/xiangqi.js:419
msgid "The general 帥/將 steps one point straight and never leaves its palace. Advisors 仕/士 step one point diagonally along the palace's diagonal lines."
msgstr "De generaal 帥/將 stapt één punt recht en verlaat nooit zijn paleis. Adviseurs 仕/士 stappen één punt diagonaal langs de diagonale lijnen van het paleis."

#: src/variants/xiangqi.js:420
msgid "Elephants 相/象 move exactly two points diagonally and never cross the river. Horses 傌/馬 move one point straight, then one diagonally outwards. Both are blocked by a piece on the point they pass, and a ghost blocks them only where it really is."
msgstr "Olifanten 相/象 gaan precies twee punten diagonaal en steken nooit de rivier over. Paarden 傌/馬 gaan één punt recht en dan één diagonaal naar buiten. Beide worden geblokkeerd door een stuk op het punt dat ze passeren, en een spookstuk blokkeert ze alleen waar het echt staat."

#: src/variants/xiangqi.js:421
msgid "Chariots 俥/車 move like rooks. Cannons 炮/砲 move like rooks too, but capture only by jumping over exactly one piece of either colour. A ghost works as that screen only in the possibilities where it is really there."
msgstr "Wagens 俥/車 gaan als torens. Kanonnen 炮/砲 gaan ook als torens, maar slaan alleen door over precies één stuk van welke kleur ook te springen. Een spookstuk werkt alleen als scherm in de mogelijkheden waarin het er echt staat."

#: src/variants/xiangqi.js:422
msgid "Soldiers 兵/卒 step one point forward, and also sideways once they have crossed the river. They never move back and never promote. Generals and soldiers are always solid; every other piece can split."
msgstr "Soldaten 兵/卒 stappen één punt vooruit, en ook opzij zodra ze de rivier zijn overgestoken. Ze gaan nooit terug en promoveren nooit. Generaals en soldaten staan altijd vast; elk ander stuk kan splitsen."

#: src/variants/xiangqi.js:423
msgid "Capture the enemy general to win. If the two generals stand on one file with nothing between them, the player to move may fly along the file and capture the other general. A ghost between them shields only where it really is."
msgstr "Sla de vijandelijke generaal om te winnen. Als de twee generaals op één lijn staan zonder iets ertussen, mag de speler aan zet over de lijn vliegen en de andere generaal slaan. Een spookstuk ertussen schermt alleen af waar het echt staat."

#: src/variants/xiangqi.js:424
msgid "You lose at once if every move you have would let your general be captured for certain, or if you have no move at all. It is a draw when no chariot, horse, cannon or soldier is left and the generals do not face each other, or after 50 moves by each side without a capture."
msgstr "Je verliest meteen als elke zet die je hebt je generaal zeker slaanbaar laat, of als je helemaal geen zet hebt. Het is remise als er geen wagen, paard, kanon of soldaat meer is en de generaals niet tegenover elkaar staan, of na 50 zetten per kant zonder slag."

#: src/variants/xiangqi.js:425
msgid "Unlike standard xiangqi, there is no repetition rule: perpetual check does not lose."
msgstr "Anders dan in het gewone xiangqi is er geen herhalingsregel: eeuwig schaak verliest niet."

#: src/variants/xiangqi.js:481
msgid "a general was captured"
msgstr "een generaal is geslagen"

#. TRANSLATORS: Xiangqi: every move of the loser would have let its general be captured for certain
#: src/variants/xiangqi.js:484
msgid "the general could not escape"
msgstr "de generaal kon niet ontsnappen"

#. TRANSLATORS: Xiangqi, why the game was drawn: no chariot, horse, cannon or soldier is left
#: src/variants/xiangqi.js:487
msgid "no piece left that can cross the river"
msgstr "geen stuk meer over dat de rivier kan oversteken"

#. TRANSLATORS: Xiangqi, why the game was drawn
#: src/variants/xiangqi.js:490
msgid "50 moves by each side without a capture"
msgstr "50 zetten per kant zonder slag"

